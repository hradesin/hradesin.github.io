---
import Layout from '../../layouts/Layout.astro';
import status from '../../data/status.json';
import { formatPrague } from '../../lib/format';
import { getVault } from '../../lib/admin-vault';

const stav = status.tece ? 'ano' : 'ne';

// GitHub token zamčený heslem – obojí jen z GitHub secrets. Šifrovaný blob
// si stránka stahuje zvlášť z /admin/klic.json, tady jen víme, jestli existuje.
const vault = await getVault();
---

<Layout title="Změnit stav vody" noindex stav={stav}>
  <main class="admin">
    <h1>Změnit stav vody</h1>
    <p class="now">
      Web teď ukazuje <strong id="current">{status.tece ? 'ANO' : 'NE'}</strong>{' '}
      <span class="muted">(<time id="current-time">{formatPrague(status.zmeneno)}</time>)</span>
    </p>

    <form id="login" class="login" hidden>
      <label for="token">Heslo</label>
      <input
        id="token"
        name="token"
        type="password"
        autocomplete="current-password"
        spellcheck="false"
        required
      />
      {
        !vault && (
          <p class="hint">
            Heslo ještě není nastavené. Zatím se přihlaste GitHub tokenem (viz README).
          </p>
        )
      }
      <button type="submit" class="btn btn-quiet">Přihlásit</button>
    </form>

    <div id="controls" class="controls" hidden>
      <button type="button" class="btn btn-ano" data-tece="true">Teče</button>
      <button type="button" class="btn btn-ne" data-tece="false">Neteče</button>
    </div>

    <p id="message" class="message" role="status" aria-live="polite"></p>

    <p class="links">
      <a href={import.meta.env.BASE_URL}>Zobrazit web</a>
      <button type="button" id="logout" class="link" hidden>Odhlásit</button>
    </p>
  </main>

</Layout>

<script>
  import { REPO, BRANCH, STATUS_PATH } from '../../config';
  import { formatPrague } from '../../lib/format';
  import { unseal, type Vault } from '../../lib/vault';

  type Status = { tece: boolean; zmeneno: string };

  const TOKEN_KEY = 'hradesin-voda:token';

  /** Čerstvý šifrovaný token (HTML může být z cache starší než poslední výměna tokenu). */
  async function loadVault(): Promise<Vault | null> {
    try {
      const res = await fetch(`${base}admin/klic.json?t=${Date.now()}`, { cache: 'no-store' });
      return res.ok ? ((await res.json()) as Vault | null) : null;
    } catch {
      return null;
    }
  }
  const API = `https://api.github.com/repos/${REPO}/contents/${STATUS_PATH}`;
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const login = $<HTMLFormElement>('login');
  const tokenInput = $<HTMLInputElement>('token');
  const controls = $<HTMLDivElement>('controls');
  const message = $<HTMLParagraphElement>('message');
  const logout = $<HTMLButtonElement>('logout');
  const current = $<HTMLElement>('current');
  const currentTime = $<HTMLElement>('current-time');
  const buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>('button'));

  // Rozšifrovaný token žije jen v tomto panelu (sessionStorage), po zavření se zapomene.
  const store = {
    get: () => {
      try {
        return sessionStorage.getItem(TOKEN_KEY);
      } catch {
        return null;
      }
    },
    set: (v: string) => {
      try {
        sessionStorage.setItem(TOKEN_KEY, v);
      } catch {
        /* soukromé okno – token platí jen do zavření stránky */
      }
    },
    clear: () => {
      try {
        sessionStorage.removeItem(TOKEN_KEY);
      } catch {
        /* nic */
      }
    },
  };

  // Úklid po starší verzi, která token ukládala natrvalo.
  try {
    localStorage.removeItem(TOKEN_KEY);
  } catch {
    /* nic */
  }

  let token = store.get();

  function say(text: string, tone: 'info' | 'ok' | 'error' = 'info') {
    message.textContent = text;
    message.dataset.tone = tone;
  }

  function showStatus(s: Status) {
    current.textContent = s.tece ? 'ANO' : 'NE';
    currentTime.textContent = formatPrague(s.zmeneno);
    document.body.dataset.stav = s.tece ? 'ano' : 'ne';
  }

  function showUi() {
    const loggedIn = Boolean(token);
    login.hidden = loggedIn;
    controls.hidden = !loggedIn;
    logout.hidden = !loggedIn;
    if (!loggedIn) tokenInput.focus();
  }

  const headers = () => ({
    Accept: 'application/vnd.github+json',
    Authorization: `Bearer ${token}`,
  });

  async function fetchLive(): Promise<Status | null> {
    try {
      const res = await fetch(`${base}status.json?t=${Date.now()}`, { cache: 'no-store' });
      return res.ok ? ((await res.json()) as Status) : null;
    } catch {
      return null;
    }
  }

  const looksLikeToken = (s: string) => /^(github_pat_|ghp_)\w+$/.test(s);

  login.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = tokenInput.value;
    if (!input.trim()) return;
    say('Ověřuji heslo…');

    // Heslo odemkne token; přímo vložený GitHub token funguje jako záloha.
    let candidate: string;
    const vault = looksLikeToken(input.trim()) ? null : await loadVault();
    if (looksLikeToken(input.trim())) {
      candidate = input.trim();
    } else if (!vault) {
      return say('Heslo ještě není nastavené. Přihlaste se GitHub tokenem.', 'error');
    } else {
      try {
        candidate = await unseal(vault, input);
      } catch {
        tokenInput.select();
        return say('Špatné heslo.', 'error');
      }
    }

    const res = await fetch('https://api.github.com/user', {
      headers: { Accept: 'application/vnd.github+json', Authorization: `Bearer ${candidate}` },
    }).catch(() => null);
    if (!res) return say('Nepodařilo se spojit s GitHubem. Zkontrolujte připojení.', 'error');
    if (!res.ok)
      return say(
        looksLikeToken(input.trim())
          ? 'Token nefunguje. Zkontrolujte, že jste vložili celý.'
          : 'Heslo sedí, ale GitHub token za ním vypršel. Vytvořte nový (viz README).',
        'error',
      );
    token = candidate;
    store.set(candidate);
    tokenInput.value = '';
    say('Přihlášeno.', 'ok');
    showUi();
  });

  logout.addEventListener('click', () => {
    token = null;
    store.clear();
    say('Odhlášeno.');
    showUi();
  });

  async function save(tece: boolean) {
    buttons.forEach((b) => (b.disabled = true));
    const label = tece ? 'ANO' : 'NE';
    try {
      say(`Ukládám ${label}…`);
      const getRes = await fetch(`${API}?ref=${BRANCH}`, { headers: headers(), cache: 'no-store' });
      if (getRes.status === 401) throw new Error('auth');
      if (!getRes.ok) throw new Error(`GitHub vrátil ${getRes.status} při čtení stavu.`);
      const { sha } = (await getRes.json()) as { sha: string };

      const next: Status = { tece, zmeneno: new Date().toISOString().replace(/\.\d{3}Z$/, 'Z') };
      const putRes = await fetch(API, {
        method: 'PUT',
        headers: { ...headers(), 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: `Stav vody: ${label}`,
          content: btoa(JSON.stringify(next, null, 2) + '\n'),
          sha,
          branch: BRANCH,
        }),
      });
      if (putRes.status === 401) throw new Error('auth');
      if (putRes.status === 403 || putRes.status === 404)
        throw new Error('Token nemá právo zapisovat. Potřebuje oprávnění Contents: Read and write.');
      if (putRes.status === 409) throw new Error('Stav se mezitím změnil. Zkuste to znovu.');
      if (!putRes.ok) throw new Error(`GitHub vrátil ${putRes.status} při ukládání.`);

      await waitForDeploy(next);
    } catch (err) {
      const msg = (err as Error).message;
      if (msg === 'auth') {
        token = null;
        store.clear();
        showUi();
        say('Heslo přestalo platit. Přihlaste se znovu.', 'error');
      } else {
        say(msg || 'Uložení selhalo.', 'error');
      }
    } finally {
      buttons.forEach((b) => (b.disabled = false));
    }
  }

  async function waitForDeploy(next: Status) {
    const label = next.tece ? 'ANO' : 'NE';
    const started = Date.now();
    while (Date.now() - started < 5 * 60_000) {
      const secs = Math.round((Date.now() - started) / 1000);
      say(`Uloženo. Web se aktualizuje, obvykle do minuty (${secs} s)…`);
      await new Promise((r) => setTimeout(r, 5000));
      const live = await fetchLive();
      if (live && live.zmeneno === next.zmeneno) {
        showStatus(live);
        say(`Hotovo. Web teď ukazuje ${label}.`, 'ok');
        return;
      }
    }
    say(
      'Uloženo, ale web se zatím neaktualizoval. Zkontrolujte záložku Actions na GitHubu.',
      'error',
    );
  }

  buttons.forEach((b) => b.addEventListener('click', () => save(b.dataset.tece === 'true')));

  showUi();
  fetchLive().then((s) => s && showStatus(s));
</script>

<style>
  /* Admin je další list připíchnutý na nástěnce. */
  .admin {
    --ink: var(--paper-ink);
    --muted: rgba(29, 27, 24, 0.72);
    /* Obrys pole pro heslo aspoň 3 : 1 proti bílé. */
    --line: rgba(29, 27, 24, 0.6);
    --tile: #ffffff;
    --answer: var(--stamp);
    position: relative;
    width: min(480px, calc(100% - 32px));
    margin: max(40px, env(safe-area-inset-top)) auto 48px;
    padding: 48px 20px 32px;
    color: var(--paper-ink);
    background: var(--paper);
    rotate: -0.6deg;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.08),
      0 22px 40px -20px rgba(0, 0, 0, 0.6);
  }

  .admin::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff9b8f 0 16%, #e23a2b 46%, #9c170c 100%);
    box-shadow: 2px 4px 4px rgba(0, 0, 0, 0.35);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .now {
    margin: 12px 0 32px;
  }

  .now strong {
    font-family: var(--font-display);
    font-size: 1.9em;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--answer);
    vertical-align: -0.12em;
  }

  .muted,
  .hint {
    color: var(--muted);
  }

  .login {
    display: grid;
    gap: 8px;
  }

  .login label {
    font-weight: 700;
  }

  .login input {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    font: inherit;
    color: var(--ink);
    background: var(--tile);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
  }

  .hint {
    margin: 0 0 8px;
    font-size: 0.875rem;
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .btn {
    min-height: 52px;
    padding: 12px 20px;
    font: inherit;
    font-weight: 700;
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      transform 0.1s ease,
      opacity 0.2s ease;
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: progress;
  }

  /* Dvě razítka na papíře. */
  .controls .btn {
    min-height: 128px;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--paper);
    box-shadow:
      inset 0 0 0 5px currentColor,
      inset 0 0 0 9px var(--paper),
      inset 0 0 0 11px currentColor,
      0 14px 24px -14px rgba(0, 0, 0, 0.6);
  }

  .btn-ano {
    color: #3d3fb0;
    rotate: -1.5deg;
  }

  .btn-ne {
    color: #c8281f;
    rotate: 1.5deg;
  }

  .btn-quiet {
    color: var(--paper);
    background: var(--paper-ink);
  }

  .message {
    min-height: 3em;
    margin: 24px 0 0;
  }

  .message[data-tone='ok'],
  .message[data-tone='error'] {
    font-weight: 700;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 16px 0 0;
    font-size: 0.9375rem;
  }

  .link {
    padding: 0;
    font: inherit;
    color: var(--muted);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>
