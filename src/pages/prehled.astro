---
import Layout from '../layouts/Layout.astro';
import status from '../data/status.json';
import { UMAMI } from '../config';
import {
  AKTUALIZOVANO,
  DODAVKA,
  KALENDAR,
  MISTA,
  ODBERY,
  PRIVADEC,
  ZDROJE,
} from '../data/prehled';

const stav = status.tece ? 'ano' : 'ne';
const home = import.meta.env.BASE_URL;
const canonical = new URL('prehled/', new URL(home, Astro.site)).href;
const version = Math.floor(Date.parse(status.zmeneno) / 1000);
const image = new URL(`og-${stav}.jpg?v=${version}`, new URL(home, Astro.site)).href;

// Datum bez časových pásem: poledne UTC, čteme UTC části.
const den = (iso: string) => new Date(`${iso}T12:00:00Z`);
const kratce = (iso: string) => `${den(iso).getUTCDate()}. ${den(iso).getUTCMonth() + 1}.`;
const ODBER_TEXT = { nevyhovel: 'nevyhověl', ceka: 'čeká se na výsledek', vyhovel: 'vyhověl' } as const;
const V_DNU = ['v neděli', 'v pondělí', 'v úterý', 've středu', 've čtvrtek', 'v pátek', 'v sobotu'];
const NAZVY_DNU = ['neděle', 'pondělí', 'úterý', 'středa', 'čtvrtek', 'pátek', 'sobota'];
const aktualizovano = `${kratce(AKTUALIZOVANO)} ${den(AKTUALIZOVANO).getUTCFullYear()}`;

const title = 'Voda v Hradešíně: přehled';
const description = `Proč v Hradešíně neteče voda, kdy začne fungovat přivaděč z Úval, kde stojí cisterny a co dělat. Jen podle oznámení obcí a provozovatele. Stav k ${aktualizovano}.`;

// Kalendář: týden od pondělí, první den doplněný prázdnými políčky.
const prvni = den(KALENDAR[0].datum);
const predsazeni = (prvni.getUTCDay() + 6) % 7;
const bunky = [...Array.from({ length: predsazeni }, () => null), ...KALENDAR];
const sledovane = KALENDAR.filter((d) => d.stav !== 'nevime');
const dnuBezVody = sledovane.filter((d) => d.stav === 'vypadek').length;
const vychozi = [...KALENDAR].reverse().find((d) => d.pozn) ?? KALENDAR[KALENDAR.length - 1];
const STAV_TEXT = { vypadek: 'bez vody aspoň část dne', ok: 'výpadek nebyl hlášen', nevime: 'zatím nevíme' } as const;
const popisDne = (d: (typeof KALENDAR)[number]) =>
  `${NAZVY_DNU[den(d.datum).getUTCDay()]} ${kratce(d.datum)}`;

const KROK_TEXT = { hotovo: 'hotovo', probiha: 'probíhá', ceka: 'čeká' } as const;
---

<Layout
  title={title}
  description={description}
  stav={stav}
  canonical={canonical}
  image={image}
  imageAlt="Přehled situace s vodou v Hradešíně"
>
  <script
    slot="head"
    is:inline
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id={UMAMI.websiteId}
    data-domains={UMAMI.domain}
  ></script>

  <header class="hlava">
    <a class="zpet" href={home}><span aria-hidden="true">←</span> Teče voda v Hradešíně?</a>
    <h1>Voda v&nbsp;Hradešíně</h1>
    <p class="podtitul">Proč neteče, kdy poteče a&nbsp;co dělat. Stav k&nbsp;{aktualizovano}.</p>
  </header>

  <main class="deska">
    <!-- ---------- Teď ---------- -->
    <section class="list ted" aria-labelledby="h-ted" style="--r: -0.4deg">
      <h2 id="h-ted">Jak to vypadá teď</h2>
      <div class="dlazdice">
        <div class="dlazdice-1">
          <svg class="ikona" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M16 9v7l5 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <p class="stitek-dl">Poslední ohlášená dodávka</p>
          <p class="cislo">{DODAVKA.cas}</p>
          <p class="pod">
            <span class="den-dodavky" data-den={DODAVKA.datum} data-kratce={kratce(DODAVKA.datum)}>
              {V_DNU[den(DODAVKA.datum).getUTCDay()]} {kratce(DODAVKA.datum)}
            </span>
            {DODAVKA.pozn}
          </p>
        </div>
        <div>
          <svg class="ikona" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="5" y="7" width="22" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M5 13h22M11 4v6M21 4v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <text x="16" y="25" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor">?</text>
          </svg>
          <p class="stitek-dl">Další dodávka</p>
          <p class="cislo">?</p>
          <p class="pod">pravidelný čas domluvit nejde, některý den voda nepoteče vůbec (Stavokomplet, 9.&nbsp;11.)</p>
        </div>
        <div class="cisterny">
          <svg class="ikona" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="3" y="10" width="18" height="11" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M21 13h4l3 4v4h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <circle cx="9" cy="24" r="2.6" fill="currentColor" />
            <circle cx="24" cy="24" r="2.6" fill="currentColor" />
          </svg>
          <p class="stitek-dl">Cisterny s&nbsp;pitnou vodou</p>
          <p class="pod"><strong>Podle obce (9.&nbsp;11.) jsou už uzamčené.</strong> Cisterna od úřadu je přemístěná k&nbsp;hlavní silnici. Klepnutím otevřete mapu:</p>
          <ul class="mista">
            <li>
              <a class="misto" href={MISTA.cp119} target="_blank" rel="noopener">
                <svg class="pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Z" fill="currentColor" /><circle cx="12" cy="9" r="2.6" fill="#f7f3ea" /></svg>
                <span class="misto-text"><strong>U&nbsp;hlavní silnice</strong> čp.&nbsp;119 (u&nbsp;Vítovských)</span>
                <span class="misto-mapa">mapa <span aria-hidden="true">↗</span></span>
              </a>
            </li>
            <li>
              <a class="misto" href={MISTA.hrbitov} target="_blank" rel="noopener">
                <svg class="pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Z" fill="currentColor" /><circle cx="12" cy="9" r="2.6" fill="#f7f3ea" /></svg>
                <span class="misto-text"><strong>U&nbsp;hřbitova</strong></span>
                <span class="misto-mapa">mapa <span aria-hidden="true">↗</span></span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <p class="zive">
        Jestli voda teče právě teď, ukazuje razítko na <a href={home}>hlavní stránce</a>{' '}
        <span class:list={['mini-razitko', stav]}>{status.tece ? 'ANO' : 'NE'}</span>
      </p>
    </section>

    <!-- ---------- Přivaděč ---------- -->
    <section class="list privadec" aria-labelledby="h-priv" style="--r: 0.25deg">
      <h2 id="h-priv">Přivaděč z&nbsp;Úval: stav prací</h2>
      <ol class="kroky" style={`--kroku: ${PRIVADEC.length}`}>
        {
          PRIVADEC.map((k) => (
            <li class:list={['krok', k.stav, k.odkaz && 'klik']}>
              <span class="krok-znak" aria-hidden="true">
                {k.stav === 'hotovo' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M6 12.5 10.2 16.5 18 8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {k.stav === 'probiha' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M7 4h10M7 20h10M8 4c0 5 8 5 8 8s-8 3-8 8M16 4c0 5-8 5-8 8s8 3 8 8" fill="none" stroke="#0b5f9e" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                )}
              </span>
              <span class="krok-stav">{KROK_TEXT[k.stav]}</span>
              {k.odkaz ? (
                <a class="krok-co krok-odkaz" href={k.odkaz}>{k.co}</a>
              ) : (
                <span class="krok-co">{k.co}</span>
              )}
              <span class="krok-kdy">
                {k.pozor && <strong class="krok-pozor"><span aria-hidden="true">✕</span> {k.pozor}</strong>}
                {k.kdy}
                {k.odkaz && (
                  <span class="krok-vic" aria-hidden="true">
                    co to znamená <span class="sipka-dolu">↓</span>
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="poznamka">P = obec Přišimasy, H = obec Hradešín, v&nbsp;závorce datum zprávy. Novější zprávy zatím nejsou.</p>

      <div class="privadec-dole">
        <div class="kdy">
          <h3>Kdy poteče voda z&nbsp;Úval?</h3>
          <p><strong>Oficiální termín zatím není.</strong></p>
          <p>
            První vzorky vody z&nbsp;přivaděče (3.&nbsp;11.) v&nbsp;rozboru nevyhověly. Další se odebraly 6.&nbsp;11.
            a&nbsp;čeká se na výsledky (obec Hradešín, 9.&nbsp;11.).
          </p>
          <p>
            Kromě vyhovujícího rozboru ještě chybí dokončení propojení s&nbsp;vodojemem a&nbsp;povolení
            k&nbsp;předčasnému užívání. Teprve pak může do vodojemu Hradešín téct i&nbsp;voda z&nbsp;Úval (obec
            Hradešín, 29.&nbsp;10. a&nbsp;6.&nbsp;11.).
          </p>
          <p><a href="#rozbor">Co znamená, že rozbor nevyhověl?</a></p>
        </div>
        <div class="kdy">
          <h3>Co přivaděč přinese</h3>
          <p>Voda z&nbsp;Úval posílí stávající vodojem Hradešín (obec Hradešín, 26.&nbsp;10.).</p>
          <p>
            U&nbsp;vodojemu Hradešín se zároveň staví nový objekt. Přivaděč se proto zatím napojí na stávající vodojem
            dočasným potrubím (Přišimasy 3.&nbsp;11., Hradešín 6.&nbsp;11.).
          </p>
          <p>
            Další krok jsou nové vlastní vrty obce. Jsou už vyvrtané, firma na jejich napojení je vybraná a&nbsp;stavba
            má začít příští rok.
          </p>
        </div>
      </div>
    </section>

    <!-- ---------- Rozbor vody z přivaděče ---------- -->
    <section class="list rozbor" id="rozbor" aria-labelledby="h-rozbor" style="--r: -0.15deg">
      <h2 id="h-rozbor">Rozbor vody z&nbsp;přivaděče</h2>
      <p class="rozbor-uvod">
        <strong>U&nbsp;nového potrubí se s&nbsp;tím počítá.</strong> Po stavbě v&nbsp;něm bývají nečistoty a&nbsp;voda v&nbsp;nových
        trubkách stojí. Proto se proplachuje a&nbsp;vzorky se odebírají znovu, dokud nevyhoví.
      </p>

      <div class="cesta">
        {
          ODBERY.map((o, i) => (
            <Fragment>
              {i > 0 && <div class="spoj"><span>proplach</span></div>}
              <div class:list={['uzel', o.stav]}>
                {o.stav === 'ceka' && <span class="uzel-ted">teď</span>}
                <span class="uzel-znak" aria-hidden="true">
                  {o.stav === 'nevyhovel' && '✕'}
                  {o.stav === 'vyhovel' && '✓'}
                  {o.stav === 'ceka' && (
                    <svg viewBox="0 0 24 24">
                      <path d="M7 4h10M7 20h10M8 4c0 5 8 5 8 8s-8 3-8 8M16 4c0 5-8 5-8 8s8 3 8 8" fill="none" stroke="#0b5f9e" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <span class="uzel-kdy">{kratce(o.datum)}</span>
                <strong class="uzel-co">{i + 1}. odběr vzorků</strong>
                <span class="uzel-stav">{ODBER_TEXT[o.stav]}</span>
              </div>
            </Fragment>
          ))
        }
        <div class="spoj"><span>vyhoví</span></div>
        <div class:list={['uzel', 'cil', ODBERY[ODBERY.length - 1]?.stav === 'vyhovel' && 'hotovo']}>
          <span class="uzel-znak" aria-hidden="true">✓</span>
          <span class="uzel-kdy">potom</span>
          <strong class="uzel-co">Napojení přivaděče</strong>
          <span class="uzel-stav">po vyhovujícím rozboru a&nbsp;povolení</span>
        </div>
      </div>
      <p class="smycka">
        <span class="smycka-znak" aria-hidden="true">↺</span>
        <span>Když vzorky nevyhoví, potrubí se znovu propláchne a&nbsp;odebere se další vzorek.</span>
      </p>

      <ul class="rozbor-fakta">
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2" />
            <text x="16" y="22" text-anchor="middle" font-size="17" font-weight="700" fill="currentColor">§</text>
          </svg>
          <span><strong>Předpisy s&nbsp;tím počítají.</strong> Když vzorek nevyhoví, odběr se „neprodleně opakuje“.</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M7 5h9M11.5 5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path d="M3 10h14a6 6 0 0 1 6 6v2h-5v-1.5a1.5 1.5 0 0 0-1.5-1.5H3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="M20.5 22c-1.3 1.8-2 2.9-2 3.8a2 2 0 0 0 4 0c0-.9-.7-2-2-3.8Z" fill="currentColor" />
          </svg>
          <span><strong>Kohoutků se to netýká.</strong> Přivaděč ještě není napojený na vodojem.</span>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M16 9v7l5 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span><strong>Na výsledek se čeká.</strong> Rozbor v&nbsp;laboratoři trvá nejméně 24 hodin.</span>
        </li>
      </ul>
      <p class="poznamka">
        Zdroje: obec Hradešín <a href="https://www.hradesin.cz/obecni-urad/aktuality/informace-voda-78cs.html" rel="noopener">9.&nbsp;11.</a> a&nbsp;<a href="https://www.hradesin.cz/obecni-urad/aktuality/informace-voda-silnice-75cs.html" rel="noopener">6.&nbsp;11.</a>,{' '}
        <a href="https://www.zakonyprolidi.cz/cs/2004-252" rel="noopener">vyhláška 252/2004 Sb.</a> (§&nbsp;4 a&nbsp;§&nbsp;9),{' '}
        <a href="https://szu.gov.cz/wp-content/uploads/2023/02/pece_o_sit.pdf" rel="noopener">Státní zdravotní ústav (2014)</a>. Který ukazatel nevyhověl, obec neuvedla.
      </p>
    </section>

    <!-- ---------- Co dělat ---------- -->
    <section class="list delat" aria-labelledby="h-delat" style="--r: -0.25deg">
      <h2 id="h-delat">Co dělat</h2>
      <ul class="seznam">
        <li>
          <span class="odrazka" aria-hidden="true">1</span>
          <span><strong>Šetřete vodou a&nbsp;mějte doma zásobu balené pitné vody.</strong> Výpadek může přijít kdykoli:
          systém se vypíná sám a&nbsp;předem se to nedá odhadnout (obec, 26. a&nbsp;29.&nbsp;10.).</span>
        </li>
        <li>
          <span class="odrazka" aria-hidden="true">2</span>
          <span><strong>Cisterny s&nbsp;pitnou vodou</strong> stojí <a href={MISTA.cp119} target="_blank" rel="noopener">u&nbsp;čp.&nbsp;119 u&nbsp;hlavní silnice</a> (přemístěná od úřadu) a&nbsp;<a href={MISTA.hrbitov} target="_blank" rel="noopener">u&nbsp;hřbitova</a> (odkazy otevřou mapu). Podle obce (9.&nbsp;11.) jsou už uzamčené.</span>
        </li>
        <li>
          <span class="odrazka" aria-hidden="true">3</span>
          <span><strong>Zprávy obce do mobilu:</strong> aplikace <a href="https://www.hradesin.cz/zivot-v-obci/mobilni-aplikace-v-obraze/" rel="noopener">V&nbsp;obraze</a> (přidejte si obec Hradešín a&nbsp;povolte upozornění) nebo <a href="https://smart-info.cz/registrace/?websiteId=946" rel="noopener">zprávy SMS a&nbsp;e-mailem</a>.</span>
        </li>
      </ul>
    </section>

    <!-- ---------- Kontakty ---------- -->
    <section class="list kontakty" aria-labelledby="h-kontakty" style="--r: 0.45deg">
      <h2 id="h-kontakty">Na koho se obrátit</h2>
      <dl>
        <dt>Stavokomplet, provozovatel vodovodu</dt>
        <dd>Odpovídá za provoz, informace o&nbsp;výpadcích i&nbsp;náhradní vodu (cisterny). Smlouvu na vodu máte s&nbsp;ním. Tel. <a href="tel:+420326906087">326&nbsp;906&nbsp;087</a></dd>
        <dt>Obec Hradešín</dt>
        <dd>
          <a href={MISTA.urad} target="_blank" rel="noopener">Hradešín 114</a>, úřední hodiny ve středu 15–18&nbsp;h.{' '}
          <a href="mailto:obec@hradesin.cz">obec@hradesin.cz</a>, tel. <a href="tel:+420724188989">724&nbsp;188&nbsp;989</a>{' '}
          nebo <a href="tel:+420321672859">321&nbsp;672&nbsp;859</a>
        </dd>
        <dt>Žádost o&nbsp;informace (zákon 106/1999&nbsp;Sb.)</dt>
        <dd>
          Úřad musí odpovědět do 15&nbsp;dnů. Obec Hradešín: datová schránka <code>nswbwwa</code>. MěÚ Český Brod, vodoprávní úřad:
          datová schránka <code>jgqbsve</code>.
        </dd>
      </dl>
    </section>

    <!-- ---------- Proč ---------- -->
    <section class="list proc" aria-labelledby="h-proc" style="--r: -0.3deg">
      <h2 id="h-proc">Proč v&nbsp;Hradešíně neteče voda</h2>
      <svg
        class="schema"
        viewBox="0 0 400 452"
        role="img"
        aria-labelledby="schema-popis"
      >
        <title id="schema-popis">
          Schéma: vrty v lese plní vodojem Hradešín. Z vodojemu teče voda do většiny Přišimas samospádem, do Hradešína ji
          tlačí čerpadla. Při nízké hladině se čerpadla vypnou. Přivaděč z vodojemu Úvaly-jih zatím není v provozu.
        </title>
        <defs>
          <marker id="sipka" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 10 5 0 10Z" fill="#0b5f9e" />
          </marker>
          <pattern id="kamen" width="8" height="8" patternUnits="userSpaceOnUse">
            <rect width="8" height="8" fill="#e8dcc6" />
            <circle cx="2" cy="2" r="0.9" fill="#c9b796" />
            <circle cx="6" cy="6" r="0.9" fill="#c9b796" />
          </pattern>
        </defs>

        <!-- Vrty v lese -->
        <text x="14" y="18" class="s-nadpis">Vrty v lese</text>
        <text x="14" y="34" class="s-text">sucho, vody ubývá</text>
        <rect x="14" y="48" width="146" height="66" rx="3" fill="url(#kamen)" />
        <rect x="14" y="98" width="146" height="16" rx="2" fill="#0b5f9e" />
        <rect x="40" y="42" width="8" height="66" fill="#7d7f80" />
        <rect x="83" y="42" width="8" height="66" fill="#7d7f80" />
        <rect x="126" y="42" width="8" height="66" fill="#7d7f80" />

        <!-- Vodojem Úvaly-jih -->
        <text x="386" y="18" text-anchor="end" class="s-nadpis">Vodojem Úvaly-jih</text>
        <rect x="286" y="44" width="100" height="58" rx="6" fill="#fffdf8" stroke="#7d7f80" stroke-width="2" />
        <rect x="288" y="56" width="96" height="44" rx="4" fill="#5591c9" />

        <!-- Přivaděč (zatím neteče) -->
        <path d="M336 102V206H266" fill="none" stroke="#827f79" stroke-width="4" stroke-dasharray="7 6" />
        <text x="326" y="130" text-anchor="end" class="s-text s-tucne">přivaděč z Úval</text>
        <text x="326" y="146" text-anchor="end" class="s-text s-cervene">zatím neteče</text>

        <!-- Vrty → vodojem -->
        <path d="M87 114V206H128" fill="none" stroke="#0b5f9e" stroke-width="4" marker-end="url(#sipka)" />

        <!-- Vodojem Hradešín -->
        <text x="200" y="178" text-anchor="middle" class="s-nadpis">Vodojem Hradešín</text>
        <rect x="136" y="190" width="128" height="84" rx="6" fill="#fffdf8" stroke="#1d1b18" stroke-width="2" />
        <rect x="138" y="252" width="124" height="20" rx="4" fill="#0b5f9e" />
        <line x1="138" y1="244" x2="262" y2="244" stroke="#c8281f" stroke-width="2" stroke-dasharray="5 4" />
        <text x="200" y="236" text-anchor="middle" class="s-mala s-cervene">kritická mez</text>

        <!-- Větev Hradešín: čerpadla -->
