<script>
  // Volba „Zastavit animace“ z hlavní stránky platí i tady.
  try {
    if (localStorage.getItem('hradesin-voda:pohyb') === 'stop') document.documentElement.dataset.pohyb = 'stop';
  } catch {
    /* soukromé okno */
  }

  // Odkaz na list níž na stránce: cílový list se krátce nasvítí, ať je vidět, kam stránka sjela.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', () => {
      const cil = a.hash ? document.querySelector<HTMLElement>(a.hash) : null;
      if (!cil) return;
      cil.classList.remove('nasvit');
      void cil.offsetWidth;
      cil.classList.add('nasvit');
    });
  });

  // Datum poslední dodávky: dnes / včera / zítra podle pražského času návštěvníka.
  const denDodavky = document.querySelector<HTMLElement>('.den-dodavky[data-den]');
  if (denDodavky) {
    const dnes = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague' }).format(new Date());
    const rozdil = Math.round((Date.parse(denDodavky.dataset.den ?? '') - Date.parse(dnes)) / 864e5);
    const slovo = rozdil === 0 ? 'dnes' : rozdil === -1 ? 'včera' : rozdil === 1 ? 'zítra' : '';
    if (slovo) {
      denDodavky.textContent = `${slovo} ${denDodavky.dataset.kratce ?? ''}`;
      denDodavky.classList.toggle('je-dnes', rozdil === 0);
    }
  }

  // Kalendář: najetí, fokus nebo klepnutí na den ukáže jeho poznámku pod mřížkou.
  const detail = document.getElementById('kal-detail');
  const dny = document.querySelectorAll<HTMLButtonElement>('.kal .den[data-kdy]');

  function ukaz(b: HTMLButtonElement) {
    if (!detail) return;
    dny.forEach((d) => d.classList.toggle('vybrany', d === b));
    const silne = document.createElement('strong');
    silne.textContent = b.dataset.kdy ?? '';
    const text = document.createElement('span');
    text.textContent = b.dataset.pozn || `${b.dataset.stav?.replace(/^./, (c) => c.toUpperCase())}.`;
    detail.replaceChildren(silne, ' ', text);
  }

  dny.forEach((b) => {
    b.addEventListener('click', () => ukaz(b));
    b.addEventListener('focus', () => ukaz(b));
    b.addEventListener('mouseenter', () => ukaz(b));
  });
</script>

