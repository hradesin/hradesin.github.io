---
import Layout from '../layouts/Layout.astro';
import status from '../data/status.json';
import { getGifPools } from '../lib/gifs';
import { GIF_SLOTS, UMAMI } from '../config';
import { AKTUALIZOVANO, PRIVADEC } from '../data/prehled';

const pools = await getGifPools();
const stav = status.tece ? 'ano' : 'ne';
const slots = Array.from({ length: GIF_SLOTS }, (_, i) => i + 1);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Karta s odkazem na přehled: kolik kroků přivaděče je hotovo a ke kdy.
const krokuHotovo = PRIVADEC.filter((k) => k.stav === 'hotovo').length;
const [, mesic, den] = AKTUALIZOVANO.split('-').map(Number);
const stavK = `${den}. ${mesic}.`;
const title = status.tece ? 'ANO, voda v Hradešíně teče' : 'NE, voda v Hradešíně neteče';
const description = `Teče v Hradešíně voda? ${status.tece ? 'Ano, teď teče.' : 'Ne, teď neteče.'} Aktuální stav na jednom místě, k tomu zvířátka z GIPHY.`;

// SEO a sdílení: absolutní adresy, náhled podle stavu (?v= obejde cache Facebooku a WhatsAppu).
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).href;
const version = Math.floor(Date.parse(status.zmeneno) / 1000);
const image = new URL(`og-${stav}.jpg?v=${version}`, canonical).href;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'cs',
  dateModified: status.zmeneno,
}).replace(/</g, '\\u003c');

// Data pro skript v prohlížeči (`<` escapované, ať JSON nemůže ukončit <script>).
const data = JSON.stringify({
  status,
  ano: pools.ano,
  smutne: pools.smutne,
  nastvane: pools.nastvane,
  sucho: pools.sucho,
}).replace(/</g, '\\u003c');
---

<Layout
  title={title}
  description={description}
  stav={stav}
  canonical={canonical}
  image={image}
  imageAlt={`Razítko ${status.tece ? 'ANO' : 'NE'} pod otázkou Teče voda v Hradešíně?`}
>
  <link slot="head" rel="preconnect" href="https://media.giphy.com" crossorigin />
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd} />
  <script
    slot="head"
    is:inline
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id={UMAMI.websiteId}
    data-domains={UMAMI.domain}
  ></script>

  <main class="board">
    <section class="notice" id="notice" aria-labelledby="otazka">
      <span class="pin" aria-hidden="true"></span>
      <h1 id="otazka">Teče voda v&nbsp;Hradešíně?</h1>
      <p class="stamp" id="answer" aria-live="polite">{status.tece ? 'ANO' : 'NE'}</p>
      <p class="present" id="present">
        Kolik tu dnes bylo Hradešíňáků? <strong id="present-n">1</strong>
      </p>
    </section>

    <!-- Karta s odkazem na přehled: na desktopu místo dvou fotek vpravo nahoře, na mobilu pod listem. -->
    <a class="karta" href={`${base}prehled/`}>
      <span class="karta-pin" aria-hidden="true"></span>
      <span class="karta-obsah">
        <span class="karta-stitek">Přehled situace · stav k&nbsp;{stavK}</span>
        <span class="karta-titulek">
          <span class="jen-ne">Proč neteče a&nbsp;kdy poteče?</span>
          <span class="jen-ano">Jak je to s&nbsp;vodou a&nbsp;přivaděčem?</span>
        </span>
        <span class="karta-radek">
          <span class="tecky" aria-hidden="true">{PRIVADEC.map((k) => <i class={k.stav} />)}</span>
          <span>Přivaděč: <strong>{krokuHotovo} ze {PRIVADEC.length}</strong> kroků hotovo</span>
        </span>
        <span class="karta-radek karta-cisterny">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect x="3" y="10" width="18" height="11" rx="5" fill="none" stroke="currentColor" stroke-width="2.4" />
            <path d="M21 13h4l3 4v4h-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
            <circle cx="9" cy="24" r="2.8" fill="currentColor" />
            <circle cx="24" cy="24" r="2.8" fill="currentColor" />
          </svg>
          <span>Cisterny u&nbsp;čp.&nbsp;119 a&nbsp;u&nbsp;hřbitova, s&nbsp;mapou</span>
        </span>
        <span class="karta-cta">Otevřít přehled <span class="sipka" aria-hidden="true">→</span></span>
      </span>
    </a>

    <!-- Kohoutek na trubce: při NE z něj jen kape, při ANO teče. Kreslený, ne GIF. -->
    <button type="button" class="kohoutek" id="kohoutek" aria-label="Otočit kohoutkem">
      <span class="trubka" aria-hidden="true"></span>
      <svg class="ventil" viewBox="20 0 76 71" aria-hidden="true">
        <defs>
          <linearGradient id="g-zinek" x1="0" x2="1">
            <stop offset="0" stop-color="#5f676c" />
            <stop offset=".3" stop-color="#dfe5e8" />
            <stop offset=".55" stop-color="#aab3b8" />
            <stop offset="1" stop-color="#545b60" />
          </linearGradient>
          <linearGradient id="g-zinek-h" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5f676c" />
            <stop offset=".3" stop-color="#dfe5e8" />
            <stop offset=".55" stop-color="#aab3b8" />
            <stop offset="1" stop-color="#545b60" />
          </linearGradient>
          <linearGradient id="g-mosaz" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8d5c14" />
            <stop offset=".28" stop-color="#f8dc8c" />
            <stop offset=".55" stop-color="#d29e38" />
            <stop offset="1" stop-color="#6e430c" />
          </linearGradient>
          <linearGradient id="g-mosaz-v" x1="0" x2="1">
            <stop offset="0" stop-color="#7a4d10" />
            <stop offset=".3" stop-color="#f8dc8c" />
            <stop offset=".6" stop-color="#d29e38" />
            <stop offset="1" stop-color="#6e430c" />
          </linearGradient>
          <linearGradient id="g-kolo" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ff7a63" />
            <stop offset=".45" stop-color="#d8261a" />
            <stop offset="1" stop-color="#7d0f08" />
          </linearGradient>
        </defs>
        <!-- trubka ze zdi a koleno -->
        <rect x="80" y="0" width="12" height="34" fill="url(#g-zinek)" />
        <rect x="78" y="22" width="16" height="7" rx="1" fill="url(#g-zinek)" />
        <path d="M78 33h16v13a8 8 0 0 1-8 8H74V38h4z" fill="url(#g-zinek-h)" />
        <path d="M79 34h14" stroke="#3f4549" stroke-width="1" opacity=".5" />
        <!-- matice -->
        <rect x="66" y="36" width="9" height="20" rx="1.2" fill="url(#g-mosaz)" />
        <path d="M69 36.5v19M72 36.5v19" stroke="#6e430c" stroke-width=".7" opacity=".55" />
        <!-- tělo, vršek, vřeteno -->
        <rect x="46" y="39" width="21" height="13" fill="url(#g-mosaz)" />
        <path d="M49 39l2-10h12l2 10z" fill="url(#g-mosaz-v)" />
        <rect x="50" y="26.5" width="14" height="3.5" rx=".8" fill="url(#g-mosaz)" />
        <rect x="55.5" y="16" width="3" height="11" fill="url(#g-mosaz-v)" />
        <!-- kolečko -->
        <g class="kolo">
          <rect x="43" y="10" width="28" height="7" rx="3.5" fill="url(#g-kolo)" />
          <path d="M47 10.6v5.8M51 10.4v6.2M55 10.3v6.4M59 10.3v6.4M63 10.4v6.2M67 10.6v5.8" stroke="#7d0f08" stroke-width=".8" opacity=".5" />
          <rect x="54" y="7" width="6" height="3.4" rx="1" fill="url(#g-mosaz)" />
        </g>
        <!-- výtok -->
        <path d="M48 39h-2a10 10 0 0 0-10 10v15h12V54a2 2 0 0 1 2-2h-2z" fill="url(#g-mosaz-v)" />
        <rect x="34.5" y="63" width="15" height="7" rx="1.5" fill="url(#g-mosaz-v)" />
        <path d="M35 66.5h14" stroke="#6e430c" stroke-width=".7" opacity=".5" />
      </svg>
      <span class="spad" aria-hidden="true">
        <svg class="kapka" viewBox="0 0 20 27"><path d="M10 0C10 0 0 11.5 0 17a10 10 0 0 0 20 0C20 11.5 10 0 10 0Z" /><ellipse cx="6.2" cy="17.5" rx="2.2" ry="3.6" fill="#fff" opacity=".7" /></svg>
        <span class="proud"></span>
      </span>
      <svg class="kbelik" viewBox="0 0 100 76" aria-hidden="true">
        <defs>
          <linearGradient id="g-kbelik" x1="0" x2="1">
            <stop offset="0" stop-color="#6b7378" />
            <stop offset=".22" stop-color="#e3e8ea" />
            <stop offset=".5" stop-color="#b3bbbf" />
            <stop offset=".8" stop-color="#8c9499" />
            <stop offset="1" stop-color="#596065" />
          </linearGradient>
          <linearGradient id="g-uvnitr" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2d3236" />
            <stop offset="1" stop-color="#596166" />
          </linearGradient>
        </defs>
        <!-- ucho sklopené dozadu -->
        <path d="M11 25Q50 2 89 25" fill="none" stroke="#5a6267" stroke-width="2" />
        <!-- otvor: prázdný (NE), nebo plný vody (ANO) -->
        <ellipse cx="50" cy="24" rx="40" ry="8" fill="url(#g-uvnitr)" />
        <g class="hladina">
          <ellipse cx="50" cy="26" rx="37.5" ry="6.4" />
          <ellipse class="vlnka" cx="34" cy="26.5" rx="7" ry="1.6" />
          <ellipse class="vlnka v2" cx="34" cy="26.5" rx="7" ry="1.6" />
        </g>
        <ellipse class="plink" cx="34" cy="26" rx="6" ry="1.5" />
        <!-- plášť s prolisy -->
        <path d="M10 24L19.5 69.5Q50 78 80.5 69.5L90 24Q50 40 10 24Z" fill="url(#g-kbelik)" />
        <path d="M12.6 36.5Q50 52 87.4 36.5" fill="none" stroke="#f2f5f6" stroke-width="1.2" opacity=".7" />
        <path d="M12.8 38Q50 53.5 87.2 38" fill="none" stroke="#4d5458" stroke-width="1" opacity=".45" />
        <path d="M16.4 54.5Q50 68 83.6 54.5" fill="none" stroke="#f2f5f6" stroke-width="1.2" opacity=".7" />
        <path d="M16.6 56Q50 69.5 83.4 56" fill="none" stroke="#4d5458" stroke-width="1" opacity=".45" />
        <ellipse cx="50" cy="24" rx="40" ry="8" fill="none" stroke="#d3d9dc" stroke-width="2.6" />
        <circle cx="11.4" cy="26" r="2" fill="#7a8287" />
        <circle cx="88.6" cy="26" r="2" fill="#7a8287" />
      </svg>
    </button>

    {
      slots.map((n) => (
        <button type="button" class={`photo p${n}`} aria-label="Ukázat jiné zvíře">
          <span class="frame" aria-hidden="true" />
        </button>
      ))
    }
  </main>

  <footer class="foot">
    <p>Powered by <a href="https://giphy.com" rel="noopener">GIPHY</a></p>
    <button type="button" class="motion" id="motion" aria-pressed="false" aria-label="Zastavit animace" title="Zastavit animace">
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
      <span class="motion-text" id="motion-text">Zastavit animace</span>
    </button>
  </footer>

  <script is:inline type="application/json" id="data" set:html={data} />
</Layout>

<script>
  import { shuffle } from '../lib/format';
  import { GIF_ROTATE_MS, NE_MIX, UMAMI } from '../config';

  type Status = { tece: boolean; zmeneno: string };
  type Stav = 'ano' | 'ne';

  const data = JSON.parse(document.getElementById('data')?.textContent ?? '{}') as {
    status: Status;
    ano: string[];
    smutne: string[];
    nastvane: string[];
    sucho: string[];
  };
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  /*
   * GIFy jako animovaný WebP v <img>: obrázek se na telefonech přehraje vždycky
   * (i v úsporném režimu iPhonu, kde video samo nehraje). Statický první snímek
   * dostane jen ten, kdo animace zastaví tlačítkem nebo má v systému omezený pohyb.
   */
  const gif = (id: string, kind: 'anim' | 'gif' | 'still') =>
    `https://media.giphy.com/media/${id}/${{ anim: '200w.webp', gif: '200w.gif', still: '200w_s.gif' }[kind]}`;

  const notice = document.getElementById('notice')!;
  const answer = document.getElementById('answer')!;
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const favicon = document.querySelector<HTMLLinkElement>('link[rel="icon"]');
  const photos = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo'));

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 960px)');
  /* ---------- Pohyb: dá se zastavit (WCAG 2.2.2), volba se pamatuje ---------- */

  // Kdo má v systému zapnuté omezení pohybu, začíná se zastavenými animacemi.
  const MOTION_KEY = 'hradesin-voda:pohyb';
  let paused = reduceMotion;
  try {
    const pref = localStorage.getItem(MOTION_KEY);
    if (pref === 'stop') paused = true;
    if (pref === 'go') paused = false;
  } catch {
    /* soukromé okno */
  }
  const motionBtn = document.getElementById('motion') as HTMLButtonElement;
  const motionText = document.getElementById('motion-text')!;

  const rand = (min: number, max: number) => min + Math.random() * (max - min);
  const pick = <T,>(items: readonly T[]) => items[Math.floor(Math.random() * items.length)];
  const tilt = (min: number, max: number) => (Math.random() < 0.5 ? -1 : 1) * rand(min, max);

  /* ---------- Razítko ---------- */

  /** Bouchne razítkem: pokaždé trochu jinak natočené. */
  function stamp(animate: boolean) {
    answer.style.setProperty('--tilt', `${tilt(3, 9).toFixed(1)}deg`);
    if (!animate || paused || reduceMotion) return;
    answer.animate(
      [
        // Na telefonu menší rozmach, ať razítko při dopadu nevyletí z listu.
        { scale: wide.matches ? 1.9 : 1.4, opacity: 0 },
        { scale: 0.94, opacity: 1, offset: 0.62 },
        { scale: 1, opacity: 1 },
      ],
      { duration: 420, easing: 'cubic-bezier(0.3, 0.7, 0.4, 1)', fill: 'backwards' },
    );
    notice.animate([{ translate: '0 0' }, { translate: '0 3px' }, { translate: '0 0' }], {
      duration: 200,
      delay: 250,
      easing: 'ease-out',
    });
  }

  answer.addEventListener('click', () => stamp(true));

  /* ---------- Fotky na nástěnce ---------- */

  const PINS = ['#e23a2b', '#f2b631', '#2f7de1', '#2fa36b', '#f4f1ea'];

  /** Připíchne fotku nahodile: natočení, posun, velikost, špendlík nebo páska. */
  function scatter(el: HTMLElement) {
    const j = wide.matches ? 1 : 0.5;
    el.style.setProperty('--r', `${tilt(1.5, 8).toFixed(1)}deg`);
    el.style.setProperty('--dx', `${(rand(-10, 10) * j).toFixed(1)}px`);
    el.style.setProperty('--dy', `${(rand(-10, 10) * j).toFixed(1)}px`);
    el.style.setProperty('--s', rand(0.9, 1.04).toFixed(3));
    el.style.setProperty('--z', String(1 + Math.floor(Math.random() * 5)));
    el.style.setProperty('--pin', pick(PINS));
    el.style.setProperty('--tr', `${tilt(1, 6).toFixed(1)}deg`);
    el.dataset.hold = Math.random() < 0.6 ? 'pin' : 'tape';
  }

  /* ---------- GIFy ---------- */

  // Co už člověk viděl, přijde na řadu až nakonec (pamatuje si posledních 40).
  const SEEN_KEY = 'hradesin-voda:videno';
  let seen: string[] = [];
  try {
    seen = JSON.parse(localStorage.getItem(SEEN_KEY) || '[]');
    if (!Array.isArray(seen)) seen = [];
  } catch {
    seen = [];
  }
  function markSeen(id: string) {
    seen = [id, ...seen.filter((s) => s !== id)].slice(0, 40);
    try {
      localStorage.setItem(SEEN_KEY, JSON.stringify(seen));
    } catch {
      /* soukromé okno */
    }
  }

  const visible = new Set<HTMLElement>();
  const assigned = new Map<HTMLElement, string>();
  const changedAt = new WeakMap<HTMLElement, number>();
  let mood: Stav = data.status.tece ? 'ano' : 'ne';

  /* Při NE se fotky míchají ze tří hromádek v poměru NE_MIX (config.ts). */
  type NeHromadka = keyof typeof NE_MIX;
  type Hromadka = 'ano' | NeHromadka;
  const NE_HROMADKY = (Object.keys(NE_MIX) as NeHromadka[]).filter((k) => NE_MIX[k] > 0 && data[k]?.length);
  const hromadkaId = new Map<string, NeHromadka>();
  for (const k of NE_HROMADKY) for (const id of data[k]) hromadkaId.set(id, k);
  const queues: Record<Hromadka, string[]> = { ano: [], smutne: [], nastvane: [], sucho: [] };

  /**
   * Z jaké hromádky bude fotka. Váha = podíl + kolik do podílu na nástěnce chybí,
   * takže poměr drží, ale napůl je to náhoda a hromádky se po nástěnce stěhují.
   */
  function hromadka(photo: HTMLElement): Hromadka {
    if (mood === 'ano' || !NE_HROMADKY.length) return 'ano';
    const counts: Record<NeHromadka, number> = { smutne: 0, nastvane: 0, sucho: 0 };
    let others = 0;
    for (const [p, id] of assigned) {
      if (p === photo) continue;
      others++;
      const k = hromadkaId.get(id);
      if (k) counts[k]++;
    }
    const weights = NE_HROMADKY.map((k) => Math.max(0, NE_MIX[k] * (others + 2) - counts[k]));
    let r = Math.random() * weights.reduce((a, b) => a + b, 0);
    for (let i = 0; i < NE_HROMADKY.length; i++) {
      r -= weights[i];
      if (r < 0) return NE_HROMADKY[i];
    }
    return NE_HROMADKY[0];
  }

  /** Další GIF do fotky: nikdy ten, který už visí, a neviděné mají přednost. */
  function nextId(photo: HTMLElement): string {
    const key = hromadka(photo);
    const pool = data[key];
    const onScreen = new Set(assigned.values());
    for (let round = 0; round < 2; round++) {
      const queue = queues[key];
      while (queue.length) {
        const id = queue.pop()!;
        if (!onScreen.has(id)) return id;
      }
      const free = pool.filter((id) => !onScreen.has(id));
      const fresh = shuffle(free.filter((id) => !seen.includes(id)));
      // Fronta se bere od konce: nejdřív neviděné, pak ty viděné nejdávněji.
      const stale = free.filter((id) => seen.includes(id)).sort((a, b) => seen.indexOf(a) - seen.indexOf(b));
      queues[key] = [...stale, ...fresh];
    }
    return pick(pool);
  }

  function makeImage(id: string): HTMLImageElement {
    const img = new Image();
    img.alt = '';
    img.decoding = 'async';
    img.draggable = false;
    img.dataset.id = id;
    img.src = gif(id, paused ? 'still' : 'anim');
    return img;
  }

  /** Vloží do fotky nový GIF a prolne ho přes starý, až je načtený. */
  function show(photo: HTMLElement, id: string, attempt = 0) {
    const frame = photo.querySelector<HTMLElement>('.frame')!;
    assigned.set(photo, id);
    changedAt.set(photo, Date.now());
    markSeen(id);
    // Rychlé klikání: rozpracované načítání předchozího GIFu zahodíme.
    frame.querySelectorAll('img:not(.in)').forEach((p) => p.remove());
    const img = makeImage(id);
    let fellBack = false;
    const reveal = () => {
      if (!img.isConnected || img.classList.contains('in')) return;
      frame.querySelectorAll('img.in:not(.leaving)').forEach((old) => {
        old.classList.add('leaving');
        setTimeout(() => old.remove(), 600);
      });
      img.classList.add('in');
    };
    img.addEventListener('load', () => img.decode().then(reveal, reveal), { once: false });
    img.addEventListener('error', () => {
      if (!img.isConnected) return;
      // WebP nejde → jednou zkusit klasický GIF, pak jiné zvíře. Prázdná dlaždice nikdy.
      if (!fellBack && !paused) {
        fellBack = true;
        img.src = gif(id, 'gif');
      } else {
        img.remove();
        if (attempt < 3) show(photo, nextId(photo), attempt + 1);
      }
    });
    frame.append(img);
  }

  function fillAll() {
    for (const k of Object.keys(queues) as Hromadka[]) queues[k] = [];
    assigned.clear();
    for (const p of photos) if (visible.has(p)) show(p, nextId(p));
  }

  // Stahuje se a hraje jen to, co je na obrazovce.
  const io = new IntersectionObserver(
    (entries) => {
      // Stahuje se jen to, co je na obrazovce nebo těsně pod ní.
      for (const e of entries) {
        const photo = e.target as HTMLElement;
        if (e.isIntersecting) {
          visible.add(photo);
          if (!assigned.has(photo)) show(photo, nextId(photo));
        } else {
          visible.delete(photo);
        }
      }
    },
    { rootMargin: '200px' },
  );

  for (const photo of photos) {
    scatter(photo);
    io.observe(photo);
    // Klik = fotku někdo přepíchne a pod ní je jiné zvíře.
    photo.addEventListener('click', () => {
      scatter(photo);
      show(photo, nextId(photo));
      if (!paused && !reduceMotion) {
        photo.animate([{ scale: 0.9 }, { scale: 'var(--s)' }], {
          duration: 320,
          easing: 'cubic-bezier(0.3, 1.25, 0.5, 1)',
        });
      }
    });
  }

  // Samo od sebe se v nepravidelných intervalech vymění jedna fotka.
  {
    const [min, max] = GIF_ROTATE_MS;
    const tick = () => {
      if (!document.hidden && !paused) {
        const now = Date.now();
        const candidates = photos.filter(
          (p) => visible.has(p) && now - (changedAt.get(p) ?? 0) > max,
        );
        if (candidates.length) {
          const photo = pick(candidates);
          show(photo, nextId(photo));
        }
      }
      setTimeout(tick, rand(min, max));
    };
    setTimeout(tick, rand(min, max));
  }

  function applyMotion() {
    const label = paused ? 'Pustit animace' : 'Zastavit animace';
    motionBtn.setAttribute('aria-pressed', String(paused));
    motionBtn.setAttribute('aria-label', label);
    motionBtn.title = label;
    motionText.textContent = label;
    // Kohoutek je čisté CSS: zastavené animace = kapka visí na výtoku.
    document.documentElement.dataset.pohyb = paused ? 'stop' : 'go';
    // Obrázek nejde pozastavit – vymění se za statický první snímek a zpět.
    for (const img of document.querySelectorAll<HTMLImageElement>('.frame img')) {
      const id = img.dataset.id;
      if (id) img.src = gif(id, paused ? 'still' : 'anim');
    }
  }

  motionBtn.addEventListener('click', () => {
    paused = !paused;
    try {
      localStorage.setItem(MOTION_KEY, paused ? 'stop' : 'go');
    } catch {
      /* soukromé okno */
    }
    applyMotion();
  });
  applyMotion();

  /* ---------- Kohoutek ---------- */

  // Otočit se dá, voda tím ale nepoteče: kohoutek se jen otřese a kapka hned odkápne.
  const kohoutek = document.getElementById('kohoutek')!;
  const KAPANI_MS = 3200; // stejné jako --kapani v CSS
  kohoutek.addEventListener('click', () => {
    if (paused || reduceMotion) return;
    kohoutek.querySelector('.kolo')?.animate(
      [{ translate: '0 0' }, { translate: '0 -3px' }, { translate: '0 -3px' }, { translate: '0 0' }],
      { duration: 600, easing: 'ease-in-out' },
    );
    kohoutek.querySelector('.ventil')?.animate(
      [{ rotate: '0deg' }, { rotate: '-3deg' }, { rotate: '2deg' }, { rotate: '-1deg' }, { rotate: '0deg' }],
      { duration: 520, easing: 'ease-out' },
    );
    if (mood === 'ano') {
      kohoutek.querySelector('.proud')?.animate([{ scale: '1 1' }, { scale: '1.7 1' }, { scale: '1 1' }], {
        duration: 700,
        easing: 'ease-in-out',
      });
      return;
    }
    for (const el of kohoutek.querySelectorAll('.kapka, .plink')) {
      for (const a of el.getAnimations()) a.currentTime = KAPANI_MS * 0.5;
    }
  });

  /* ---------- Stav ---------- */

  function render(s: Status) {
    document.body.dataset.stav = s.tece ? 'ano' : 'ne';
    answer.textContent = s.tece ? 'ANO' : 'NE';
    document.title = s.tece ? 'ANO, voda v Hradešíně teče' : 'NE, voda v Hradešíně neteče';
    themeColor?.setAttribute('content', s.tece ? '#0b6fb8' : '#c69b6d');
    favicon?.setAttribute('href', `${base}favicon-${s.tece ? 'ano' : 'ne'}.svg`);
    stamp(true);
  }

  stamp(true);

  /* ---------- Kolik tu dnes bylo Hradešíňáků (Umami, od pražské půlnoci) ---------- */

  /** Dnešní půlnoc v Praze jako timestamp – stejná pro každého, ať je kdekoli. */
  function pragueMidnight(now = new Date()): number {
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Prague',
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
        hour: 'numeric',
        minute: 'numeric',
        second: 'numeric',
        hourCycle: 'h23',
      })
        .formatToParts(now)
        .map((p) => [p.type, Number(p.value)]),
    );
    const wall = Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second);
    const offset = Math.round((wall - now.getTime()) / 60_000) * 60_000;
    return Date.UTC(parts.year, parts.month - 1, parts.day) - offset;
  }

  const present = document.getElementById('present')!;
  const presentN = document.getElementById('present-n')!;
  let share: { websiteId: string; token: string } | null = null;

  async function updatePresent(retry = true): Promise<void> {
    try {
      if (!share) {
        const r = await fetch(`${UMAMI.api}/share/${UMAMI.shareId}`);
        if (!r.ok) throw new Error();
        share = (await r.json()) as { websiteId: string; token: string };
      }
      const now = Date.now();
      const query = new URLSearchParams({
        startAt: String(pragueMidnight()),
        endAt: String(now),
        timezone: 'Europe/Prague',
      });
      const r = await fetch(`${UMAMI.api}/websites/${share.websiteId}/stats?${query}`, {
        headers: { 'x-umami-share-token': share.token, 'x-umami-share-context': '1' },
        cache: 'no-store',
      });
      if (r.status === 401 && retry) {
        share = null; // token vypršel – jednou si řekneme o nový
        return updatePresent(false);
      }
      if (!r.ok) throw new Error();
      const { visitors: raw } = (await r.json()) as { visitors?: number | { value?: number } };
      const visitors = typeof raw === 'number' ? raw : raw?.value;
      if (typeof visitors !== 'number') throw new Error();
      // Kdo se právě dívá, dnes tu byl – i když ho Umami ještě nestihlo započítat.
      presentN.textContent = String(Math.max(1, visitors));
      present.classList.add('on');
    } catch {
      present.classList.remove('on'); // počítadlo je bonus, při chybě prostě zmizí
    }
  }

  // Až po chvíli, ať Umami stihne započítat i tuhle návštěvu a načtení stránky nečeká.
  setTimeout(updatePresent, 3000);

  let current = data.status;

  // GitHub Pages cachuje HTML ~10 min, čerstvý stav si proto dotahujeme zvlášť.
  async function refresh() {
    try {
      const res = await fetch(`${base}status.json?t=${Date.now()}`, { cache: 'no-store' });
      if (!res.ok) return;
      const s = (await res.json()) as Status;
      if (s.tece === current.tece) {
        current = s;
        return;
      }
      current = s;
      mood = s.tece ? 'ano' : 'ne';
      render(s);
      fillAll();
    } catch {
      /* offline – necháme poslední známý stav */
    }
  }

  refresh();
  setInterval(() => {
    if (document.hidden) return;
    refresh();
    updatePresent();
  }, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) return;
    refresh();
    updatePresent();
  });
</script>

<style>
  /*
