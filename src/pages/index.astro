---
import Layout from '../layouts/Layout.astro';
import status from '../data/status.json';
import { getGifPools } from '../lib/gifs';
import { GIF_SLOTS } from '../config';

const pools = await getGifPools();
const stav = status.tece ? 'ano' : 'ne';
const slots = Array.from({ length: GIF_SLOTS }, (_, i) => i + 1);
const title = status.tece ? 'ANO, voda v Hradešíně teče' : 'NE, voda v Hradešíně neteče';

// Data pro skript v prohlížeči (`<` escapované, ať JSON nemůže ukončit <script>).
const data = JSON.stringify({ status, ano: pools.ano, ne: pools.ne }).replace(/</g, '\\u003c');
---

<Layout title={title} description="Teče teď v Hradešíně voda? Jednoduše ano, nebo ne." stav={stav}>
  <link slot="head" rel="preconnect" href="https://media.giphy.com" crossorigin />

  <main class="stage">
    {slots.map((n) => <figure class={`tile t${n}`} aria-hidden="true" />)}

    <section class="hero" aria-labelledby="otazka">
      <h1 id="otazka">Teče voda v&nbsp;Hradešíně?</h1>
      <p class="answer" id="answer" aria-live="polite">{status.tece ? 'ANO' : 'NE'}</p>
    </section>
  </main>

  <footer class="foot">
    <p>Powered by <a href="https://giphy.com" rel="noopener">GIPHY</a></p>
  </footer>

  <script is:inline type="application/json" id="data" set:html={data} />
</Layout>

<script>
  import { shuffle } from '../lib/format';
  import { GIF_ROTATE_MS } from '../config';

  type Status = { tece: boolean; zmeneno: string };
  type Stav = 'ano' | 'ne';

  const data = JSON.parse(document.getElementById('data')?.textContent ?? '{}') as {
    status: Status;
    ano: string[];
    ne: string[];
  };
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const mp4 = (id: string) => `https://media.giphy.com/media/${id}/200w.mp4`;

  const answer = document.getElementById('answer')!;
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.tile'));

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = Boolean(
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData,
  );
  // V klidném režimu žádný pohyb sám od sebe – jen první snímek. Klepnutí pustí nový GIF.
  const calm = reduceMotion || saveData;

  /* ---------- GIFy ---------- */

  const visible = new Set<HTMLElement>();
  const assigned = new Map<HTMLElement, string>();
  let queue: string[] = [];
  let mood: Stav = data.status.tece ? 'ano' : 'ne';

  /** Další GIF z balíku pro aktuální stav – nikdy ten, který už je na obrazovce. */
  function nextId(): string {
    const pool = data[mood];
    const onScreen = new Set(assigned.values());
    for (let round = 0; round < 2; round++) {
      while (queue.length) {
        const id = queue.pop()!;
        if (!onScreen.has(id)) return id;
      }
      queue = shuffle(pool.filter((id) => !onScreen.has(id)));
    }
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function makeVideo(id: string, play: boolean): HTMLVideoElement {
    const v = document.createElement('video');
    v.muted = true;
    v.loop = true;
    v.playsInline = true;
    v.disablePictureInPicture = true;
    v.preload = play ? 'auto' : 'metadata';
    v.src = play ? mp4(id) : `${mp4(id)}#t=0.1`;
    return v;
  }

  const changedAt = new WeakMap<HTMLElement, number>();

  /** Vloží do dlaždice nový GIF a prolne ho přes starý, až je načtený. */
  function show(tile: HTMLElement, id: string, play = !calm) {
    assigned.set(tile, id);
    changedAt.set(tile, Date.now());
    // Rychlé klikání: rozpracované načítání předchozího GIFu zahodíme.
    tile.querySelectorAll('video:not(.in)').forEach((p) => p.remove());
    const v = makeVideo(id, play);
    v.addEventListener(
      'loadeddata',
      () => {
        if (!v.isConnected) return;
        tile.querySelectorAll('video.in:not(.leaving)').forEach((old) => {
          old.classList.add('leaving');
          setTimeout(() => old.remove(), 600);
        });
        v.classList.add('in');
        if (play && visible.has(tile)) v.play().catch(() => {});
      },
      { once: true },
    );
    v.addEventListener('error', () => v.remove(), { once: true });
    tile.append(v);
  }

  function fillTiles() {
    queue = [];
    assigned.clear();
    for (const tile of tiles) if (visible.has(tile)) show(tile, nextId());
  }

  // Stahuje se a hraje jen to, co je na obrazovce.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const tile = e.target as HTMLElement;
        const v = tile.querySelector<HTMLVideoElement>('video.in:not(.leaving)');
        if (e.isIntersecting) {
          visible.add(tile);
          if (!assigned.has(tile)) show(tile, nextId());
          else if (!calm) v?.play().catch(() => {});
        } else {
          visible.delete(tile);
          v?.pause();
        }
      }
    },
    { rootMargin: '100px' },
  );

  // Klik na dlaždici = nový GIF. I v klidném režimu se pak přehraje, o pohyb si člověk řekl sám.
  for (const tile of tiles) {
    io.observe(tile);
    tile.addEventListener('click', () => {
      show(tile, nextId(), true);
      if (!reduceMotion) {
        tile.animate([{ transform: 'scale(0.92)' }, { transform: 'scale(1)' }], {
          duration: 420,
          easing: 'cubic-bezier(0.3, 1.6, 0.5, 1)',
        });
      }
    });
  }

  // Každých pár sekund se jedna viditelná dlaždice prolne na další GIF z balíku
  // (ty, na které se právě klikalo, nechá chvíli být).
  if (!calm) {
    setInterval(() => {
      if (document.hidden) return;
      const now = Date.now();
      const candidates = tiles.filter(
        (t) => visible.has(t) && now - (changedAt.get(t) ?? 0) > GIF_ROTATE_MS * 2,
      );
      const tile = candidates[Math.floor(Math.random() * candidates.length)];
      if (tile) show(tile, nextId());
    }, GIF_ROTATE_MS);
  }

  /* ---------- Stav ---------- */

  function render(s: Status, changed: boolean) {
    const stav: Stav = s.tece ? 'ano' : 'ne';
    document.body.dataset.stav = stav;
    answer.textContent = s.tece ? 'ANO' : 'NE';
    document.title = s.tece ? 'ANO, voda v Hradešíně teče' : 'NE, voda v Hradešíně neteče';
    themeColor?.setAttribute('content', s.tece ? '#0b6fb8' : '#1a1311');

    if (changed && !reduceMotion) intro(stav);
  }

  /** Jediná „velká“ animace: ANO se napustí kapkami, NE jednou zabliká jako kontrolka. */
  function intro(stav: Stav) {
    if (stav === 'ano') {
      answer.animate(
        [
          { fontVariationSettings: "'ELSH' 8, 'wght' 100" },
          { fontVariationSettings: "'ELSH' 8, 'wght' 600" },
        ],
        { duration: 1200, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' },
      );
    } else {
      answer.animate(
        [{ opacity: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 0.2, offset: 0.16 }, { opacity: 1, offset: 0.24 }, { opacity: 0.35, offset: 0.32 }, { opacity: 1 }],
        { duration: 1000, easing: 'steps(1, end)' },
      );
    }
  }

  let current = data.status;

  // GitHub Pages cachuje HTML ~10 min, čerstvý stav si proto dotahujeme zvlášť.
  async function refresh() {
    try {
      const res = await fetch(`${base}status.json?t=${Date.now()}`, { cache: 'no-store' });
      if (!res.ok) return;
      const s = (await res.json()) as Status;
      if (s.tece === current.tece && s.zmeneno === current.zmeneno) return;
      const moodChanged = s.tece !== current.tece;
      current = s;
      render(s, moodChanged);
      if (moodChanged) {
        mood = s.tece ? 'ano' : 'ne';
        fillTiles();
      }
    } catch {
      /* offline – necháme poslední známý stav */
    }
  }

  refresh();
  setInterval(refresh, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
</script>

<style>
  /*
   * Desktop (≥ 960 px): 16 GIFů rámuje odpověď, celé se vejde na výšku okna.
   *   [ 1][ 2][ 3][ 4][ 5][ 6]
   *   [ 7][     odpověď    ][ 8]
   *   [ 9][                ][10]
   *   [11][12][13][14][15][16]
   * Mobil: pruh 3 GIFů, odpověď přes celou šířku, pod ní mřížka 3 × 4.
   */
  .stage {
    width: min(1320px, 100%);
    margin: 0 auto;
    padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) 0
      max(12px, env(safe-area-inset-left));
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero {
    grid-column: 1 / -1;
    order: 1;
    container-type: inline-size;
    padding: clamp(40px, 12vw, 72px) 4px clamp(36px, 10vw, 64px);
    text-align: center;
  }

  .tile:nth-of-type(n + 4) {
    order: 2;
  }

  .t16 {
    display: none;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.25rem, 0.95rem + 1.1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }

  .answer {
    margin: 0.04em 0 0;
    font-family: var(--font-dots);
    font-size: min(52cqi, 16rem);
    font-weight: 600;
    font-variation-settings: 'ELSH' 8, 'wght' 600;
    line-height: 0.82;
    letter-spacing: 0.03em;
    color: var(--answer);
    transition: color 0.6s ease;
  }

  body[data-stav='ano'] .answer {
    animation: fill 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  body[data-stav='ne'] .answer {
    text-shadow: 0 0 0.12em rgba(255, 91, 58, 0.45);
    animation: flicker 1s steps(1, end) both;
  }

  @keyframes fill {
    from {
      font-variation-settings: 'ELSH' 8, 'wght' 100;
    }
  }

  @keyframes flicker {
    0% { opacity: 0; }
    10% { opacity: 1; }
    16% { opacity: 0.2; }
    24% { opacity: 1; }
    32% { opacity: 0.35; }
    40% { opacity: 1; }
  }

  .tile {
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--tile);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .tile :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition:
      opacity 0.5s ease,
      transform 0.4s ease;
  }

  /* Nové video se vkládá na konec, takže leží nad starým, dokud se staré neodebere. */
  .tile :global(video.in) {
    opacity: 1;
  }

  /* Napověda, že se dá kliknout: GIF se pod myší lehce přiblíží. */
  @media (hover: hover) {
    .tile:hover :global(video.in) {
      transform: scale(1.06);
    }
  }

  .foot {
    padding: 28px 16px max(28px, env(safe-area-inset-bottom));
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .foot p {
    margin: 0;
  }

  @media (min-width: 960px) {
    .stage {
      /* 6 × 4 čtverce: šířka = 1,5 × dostupná výška → celé na jednu obrazovku. */
      width: min(1320px, 100%, max(900px, 1.5 * (100dvh - 24px)));
      padding-top: 12px;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        't1 t2 t3 t4 t5 t6'
        't7 hero hero hero hero t8'
        't9 hero hero hero hero t10'
        't11 t12 t13 t14 t15 t16';
    }

    .hero {
      grid-area: hero;
      container-type: size;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 16px;
    }

    .answer {
      font-size: min(36cqw, 60cqh, 19rem);
    }

    .tile:nth-of-type(n) {
      order: 0;
    }

    .t16 {
      display: block;
    }

    .t1 { grid-area: t1; }
    .t2 { grid-area: t2; }
    .t3 { grid-area: t3; }
    .t4 { grid-area: t4; }
    .t5 { grid-area: t5; }
    .t6 { grid-area: t6; }
    .t7 { grid-area: t7; }
    .t8 { grid-area: t8; }
    .t9 { grid-area: t9; }
    .t10 { grid-area: t10; }
    .t11 { grid-area: t11; }
    .t12 { grid-area: t12; }
    .t13 { grid-area: t13; }
    .t14 { grid-area: t14; }
    .t15 { grid-area: t15; }
    .t16 { grid-area: t16; }
  }
</style>
