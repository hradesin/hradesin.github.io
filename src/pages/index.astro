  }

  .ventil .kolo {
    transition: translate 0.6s ease;
  }

  /* Puštěno: vřeteno vyjede nahoru. */
  :global(body[data-stav='ano']) .ventil .kolo {
    translate: 0 -2px;
  }

  /* Prostor mezi výtokem a hladinou; kapka padá přes celou jeho výšku. */
  .spad {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    container-type: size;
  }

  .kapka {
    position: absolute;
    top: -1px;
    left: var(--x);
    width: 11%;
    margin-left: -5.5%;
    overflow: visible;
    transform-origin: 50% 0;
    scale: 0.9;
    animation: kapka var(--kapani) infinite;
  }

  .kapka path {
    fill: var(--voda);
  }

  /*
   * Odkápnutí je na začátku cyklu (0–13 %), zbytek času na výtoku roste
   * další kapka. Bez animace (zastaveno, omezený pohyb) kapka jen visí.
   */
  @keyframes kapka {
    0% {
      translate: 0 0;
      scale: 0.95 1.12;
      animation-timing-function: cubic-bezier(0.5, 0, 1, 0.6);
    }
