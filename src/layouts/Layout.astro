---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  stav?: 'ano' | 'ne';
}
const { title, description, noindex = false, stav = 'ano' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={stav === 'ne' ? '#1a1311' : '#0b6fb8'} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={`${base}fonts/handjet-cs.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/montagu-slab-cs.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`
      @font-face {
        font-family: 'Handjet';
        src: url('${base}fonts/handjet-cs.woff2') format('woff2');
        font-weight: 100 900;
        font-display: swap;
      }
      @font-face {
        font-family: 'Montagu Slab';
        src: url('${base}fonts/montagu-slab-cs.woff2') format('woff2');
        font-weight: 400 700;
        font-display: swap;
      }
    `} />
    <slot name="head" />
  </head>
  <body data-stav={stav}>
    <slot />
  </body>
</html>

<style is:global>
  /*
   * Písma (obě z Brna, OFL, ořezaná na latinku + češtinu):
   *   Handjet (Rosetta)            odpověď složená z kapek, časové razítko
   *   Montagu Slab (F. Karsten)    otázka a texty, tón obecní vyhlášky
   *
   * Paleta – dvě nálady, ne jedna přebarvená šablona:
   *   ANO  bazén   #0B6FB8  pozadí      kapka  #E9F6FF  odpověď
   *   NE   sucho   #1A1311  pozadí      kontrolka #FF5B3A odpověď
   */
  :root {
    --font-dots: 'Handjet', ui-monospace, monospace;
    --font-text: 'Montagu Slab', Georgia, 'Times New Roman', serif;

    --bg: #0b6fb8;
    --ink: #ffffff;
    --muted: rgba(255, 255, 255, 0.78);
    --answer: #e9f6ff;
    --tile: rgba(255, 255, 255, 0.12);
    --line: rgba(255, 255, 255, 0.35);

    --radius: 6px;
    --gap: 6px;
  }

  body[data-stav='ne'] {
    --bg: #1a1311;
    --ink: #f5e9e4;
    --muted: rgba(245, 233, 228, 0.7);
    --answer: #ff5b3a;
    --tile: rgba(245, 233, 228, 0.07);
    --line: rgba(245, 233, 228, 0.3);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  [hidden] {
    display: none !important;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    font-family: var(--font-text);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--ink);
    background-color: var(--bg);
    transition:
      background-color 0.6s ease,
      color 0.6s ease;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
